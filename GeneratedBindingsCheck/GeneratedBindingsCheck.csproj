<!--
  Compiles the generated C# bindings exactly as a consumer does, at the lowest
  supported TFM (net10.0, C# 14, ADR-188). Warnings are treated as errors because our generated
  code ships as contentFiles and compiles inside the consumer's build, so any
  warning we emit lands in their build (and fails it under TreatWarningsAsErrors).
  This project has no sources of its own; it consumes the packed TestLibrary
  .nupkg so NuGet pulls the transitive deps the registration shims need.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      ADR-064 amendment: the generated bindings carry XML doc comments (`<remarks>` on a class with
      no reachable public constructor). Without /doc the compiler parses them and reports nothing,
      so a malformed one (an unescaped `<init>`) would only ever surface in a consumer's build.
      With it, CS1570 is a warning here and therefore an error. CS1591 is muted because every other
      generated public member has no doc comment by design.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TestLibrary" Version="$(TestLibraryVersion)" />
  </ItemGroup>
</Project>

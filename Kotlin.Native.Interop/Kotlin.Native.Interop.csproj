<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Kotlin.Native.Interop</PackageId>
    <Version>1.0.0</Version>
    <Authors>xxfast</Authors>
    <Description>Shared exception and presence contracts for Kotlin/Native NuGet bindings.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xxfast/kotlin-native-nuget</RepositoryUrl>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>LeakTests</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A framework-dependent build without a RID does not copy runtimes/{rid}/native/*
         assets to the output root, so the [DllImport("test")] P/Invoke in the generated
         bindings fails with DllNotFoundException at runtime. Pinning a RuntimeIdentifier
         makes MSBuild copy the matching native asset next to the test host. Use the host
         RID so the tests build and run on whatever platform they execute on. -->
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="TestLibrary" Version="$(TestLibraryVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The runner only reads xunit.runner.json from the output directory. This whole project
       exists so the process-global NugetMarshal.LiveHandles counter is not moved by anything
       but the crossing under test, so serial execution is load-bearing here, not a preference. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
